{
    // 用 cmake-tools 扩展驱动构建(扩展已安装)。配置时导出 compile_commands 供 IntelliSense。
    "cmake.configureOnOpen": true,
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.generator": "Unix Makefiles",
    "cmake.configureArgs": [
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
    ],

    // C/C++ 扩展直接配置(不依赖插件时也生效)
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.intelliSenseMode": "macos-clang-arm64",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/SDK/CHeaders",
        "${workspaceFolder}/SDK/CHeaders/XPLM",
        "${workspaceFolder}/SDK/CHeaders/Widgets",
        "${workspaceFolder}/SDK/CHeaders/Wrappers",
        "${workspaceFolder}"
    ],
    "C_Cpp.default.defines": [
        "APL=1", "IBM=0", "LIN=0",
        "XPLM200=1", "XPLM210=1", "XPLM300=1", "XPLM301=1",
        "XPLM303=1", "XPLM400=1", "XPLM411=1", "XPLM420=1", "XPLM430=1"
    ],

    // ---------- Python(你学习 Python 时保留的配置)----------
    // 用机器上现成的 python3; 若在项目里建了 .venv 可改指向它。
    "python.defaultInterpreterPath": "/usr/local/bin/python3",
    "python.analysis.autoSearchPaths": true,

    // ---------- 通用编辑器建议 ----------
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": false
    },
    "editor.inlineSuggest.enabled": true,

    // Code suggestions for C++/editor features
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "cpp": true
    },

    // 代码格式化(C++)
    "editor.formatOnSave": false,
    "files.associations": {
        "*.cpp": "cpp",
        "*.h": "cpp"
    }
}
