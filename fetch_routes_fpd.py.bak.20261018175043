"""
fetch_routes_fpd.py — 从 FlightPlanDatabase 抓一条 O-D 航路，存进 SQLite。

本次更新：
  • 搜索时一次拉 100 条（limit 最大 100），本地按「下载量」降序排序
    —— FPD 没有 sort=downloads，只能拿回来自己排。
  • 选中的那条来源、cycle、下载量、航点个数全部写进数据库，方便以后筛选。
  • HTTP 与 SQLite 部分带详细注释。

运行：
    cd /Users/aic06/AI-ATC
    .venv/bin/python fetch_routes_fpd.py            # 默认 EDDF -> LOWW
    .venv/bin/python fetch_routes_fpd.py EDDF ZBAA  # 指定 O-D

⚠️ 数据仅供飞行模拟使用（FlightPlanDatabase 服务条款要求），不可用于真实飞行。
"""

import json              # JSON ↔ Python 对象
import sqlite3           # SQLite 驱动（Python 标准库）
import sys               # 命令行参数
import urllib.error      # HTTPError
import urllib.parse      # urlencode
import urllib.request    # Request / urlopen

BASE = "https://api.flightplandatabase.com"
DB_PATH = "/Users/aic06/AI-ATC/routes.db"

ORIGIN = "EDDF"
DEST   = "ZBAA"


# ═════════════════════════════════════════════════════════════
# 一、HTTP
# ═════════════════════════════════════════════════════════════
def http_get_json(path, params=None):
    """
    发 HTTP GET，把返回的 JSON 解析成 Python 对象。

    ── 一次 HTTP 请求 = 三部分 ──────────────────────────────
        请求行  GET /search/plans?fromICAO=EDDF HTTP/1.1
        请求头  Host / Accept / User-Agent
        正文    GET 没有正文
    ── 一次 HTTP 响应 = 三部分 ──────────────────────────────
        状态行  HTTP/1.1 200 OK
        响应头  Content-Type / X-Limit-Used ...
        正文    JSON 字符串（本次）

    返回 (对象, 响应头 dict)；失败 (None, None)。
    """
    # ── 1. 拼 URL ────────────────────────────────────────────
    # 查询串形如 "?a=1&b=2"。
    # ⚠️ 必须 urlencode，不能 f"?a={x}&b={y}" 手拼：
    #    & = ? 空格 都是 URL 保留字符，手拼会让参数错位；
    #    urlencode 会自动百分号编码（空格→%20，&=→%26%3D）。
    url = BASE + path
    if params:
        url += "?" + urllib.parse.urlencode(params)

    # ── 2. 构造请求对象（还没联网）───────────────────────────
    req = urllib.request.Request(
        url,
        headers={
            # 请服务器用 JSON 回；不给可能返回 XML，json.loads 就炸。
            "Accept": "application/json",
            # 表明身份；很多 API 会拒绝空的 User-Agent（当爬虫）。
            "User-Agent": "AI-ATC-route-collector/1.0",
        },
    )

    # ── 3. 发请求 ← 全脚本唯一的联网语句 ────────────────────
    try:
        # timeout=30：30 秒无响应就放弃，否则网络卡住会永久挂起。
        # with ... as resp: 离开代码块自动 close()。
        with urllib.request.urlopen(req, timeout=30) as resp:
            # resp.read() 返回 bytes（原始字节），不是 str。
            # decode("utf-8") 才变字符串；errors="replace" 遇到坏字节
            # 换成 "�" 而不是抛异常。
            body = resp.read().decode("utf-8", errors="replace")
            # 响应头转 dict，里面有 X-Limit-Used / X-Limit-Cap。
            headers = dict(resp.headers)

    except urllib.error.HTTPError as e:
        # ⚠️ 不是"网断了"，而是"服务器回话了但状态码非 2xx"：
        #   400/401 参数或权限、404 路径错、429 超限、500 服务器或参数错。
        # 必须写在 Exception 之前，因为它是 Exception 的子类。
        print(f"  ✗ HTTP {e.code}  {url}")
        return None, None

    except Exception as e:
        # DNS 失败、连接超时、TLS 错误都落这里。
        print(f"  ✗ 网络错误：{e}")
        return None, None

    # ── 4. 解析 JSON ─────────────────────────────────────────
    # json.loads 把 JSON 文本变成 Python 对象：
    #   {"a":1} → dict   [1,2] → list   "s" → str
    #   123 → int        true/false → True/False   null → None
    try:
        return json.loads(body), headers
    except json.JSONDecodeError:
        print(f"  ✗ 返回的不是 JSON，前 200 字符：{body[:200]}")
        return None, None


def search_plans(origin, dest, limit=100):
    """
    搜索某 O-D 的历史计划，返回 list[dict]。

    返回的每项主要字段：
        id          int     计划 id —— 拿详情要靠它
        fromICAO    str     起飞机场
        toICAO      str     降落机场
        distance    float   航路距离（海里）
        waypoints   int     ⚠️ 航点「个数」，不是列表
        likes       int     点赞数
        downloads   int     下载数  ← 我们按它排序
        popularity  int     服务器综合评分（不透明，下载 0 也可能排第一）
        createdAt   str     创建时间
        cycle       dict    {"ident":"FPD2106"} AIRAC 版本
        tags        list    ["generated"] = 生成器产出
        user        dict/null  null 表示无作者（生成器造）

    ⚠️ 参数名必须是 fromICAO / toICAO；写成 from= / to= 会 500。
    ⚠️ FPD 没有 sort=downloads，只能拉回来在本地排。
    """
    data, headers = http_get_json("/search/plans", {
        "fromICAO": origin,
        "toICAO": dest,
        "limit": limit,          # 上限就是 100
        "sort": "popularity",    # 先由服务器粗筛，本地再按下载量精排
    })
    if headers:
        print(f"  额度 {headers.get('X-Limit-Used')}/{headers.get('X-Limit-Cap')}")
    return data or []            # None 或空 → 空列表


def get_plan_detail(plan_id):
    """
    取单个计划的完整内容，返回 dict（失败 None）。

    比搜索结果多出：
        route.nodes  list[dict]  ⭐ 真正的航路点
    nodes 每项字段：
        type   str   APT / FIX / VOR / NDB
        ident  str   点名，如 "ESOBU"
        name   str/null 全名
        lat/lon float 经纬度
        alt    int   该点计划高度（英尺）
        via    dict/null  {"type":"AWY-HI","ident":"UN858"} 表示沿 UN858 飞来
    """
    data, _ = http_get_json(f"/plan/{plan_id}")
    return data


# ═════════════════════════════════════════════════════════════
# 二、选计划：按下载量排序
# ═════════════════════════════════════════════════════════════
def pick_best_plan(plans):
    """
    在搜索结果里挑一条，**优先保证 cycle 有值**。

    为什么要有 cycle：
        cycle 是 AIRAC 版本号，如 {"ident":"FPD2106","year":21,"release":6}。
        老计划（早期 API 写入的）这个字段是 null —— 说明当年没记录
        导航数据版本，无法判断它用的航路点现在还存不存在。
        所以有 cycle 的记录，可信度更高。

    两段式筛选（这是 "确保有 cycle" 的实现）：
        第 1 段：只保留 cycle 不为 null 的，按 downloads 降序挑最好的。
        第 2 段：如果一条带 cycle 的都没有，降级到全部计划，
                按同样规则挑，并打印警告 —— 宁可让你知道，
                也不要静默返回一条没有版本信息的记录。

    排序规则：downloads 降序 → likes 降序 → id 降序。
        key 返回元组，Python 按元组逐位比较，前面的字段权重更高。
        不用 reverse=True，是因为 max() 天生取最大的那个。

    返回 (选中的计划, 是否带 cycle)。
    """
    if not plans:
        return None, False

    # ① 先筛出 cycle 有值的（cycle 可能是 None，也可能是空 dict）
    with_cycle = [p for p in plans if (p.get("cycle") or {}).get("ident")]

    pool = with_cycle if with_cycle else plans
    best = max(
        pool,
        key=lambda p: (
            p.get("downloads") or 0,
            p.get("likes") or 0,
            p.get("id") or 0,
        ),
    )

    if not with_cycle:
        print(f"  ⚠️ 这 {len(plans)} 条计划全都没有 cycle，"
              f"退回按下载量选（结果可能较旧）")

    return best, bool(with_cycle)


# ═════════════════════════════════════════════════════════════
# 三、数据整形
# ═════════════════════════════════════════════════════════════
def extract_waypoints(detail):
    """
    从 /plan/{id} 的 route.nodes 里挖出航点名列表。

    ⚠️ 不能写 detail["route"]["nodes"]：
       detail 没 "route" → KeyError
       route 是 None      → TypeError
    用 or {} / or [] 把两层空值一次性兜住。
    """
    nodes = (detail.get("route") or {}).get("nodes") or []

    waypoints = []
    for n in nodes:
        ident = n.get("ident")
        if ident:                     # 跳过 None / 空字符串
            waypoints.append(ident)
    return waypoints


# ═════════════════════════════════════════════════════════════
# 四、SQLite
# ═════════════════════════════════════════════════════════════
def open_db():
    """
    打开（或创建）数据库并确保表存在，返回连接。

    ── SQLite 是什么 ────────────────────────────────────────
    普通数据库（MySQL/PG）是常驻服务，程序要"连接"它。
    SQLite 没有服务进程：整个库就是一个文件（routes.db），
    程序直接打开读写。Python 自带 sqlite3，零依赖。
    ────────────────────────────────────────────────────────
    """
    # 文件不存在会自动创建空库（相当于 CREATE DATABASE + USE）。
    conn = sqlite3.connect(DB_PATH)

    # CREATE TABLE IF NOT EXISTS：表在就什么都不做（不报错、不清空）。
    # 类型只有 TEXT / INTEGER / REAL / BLOB / NULL 这几种。
    conn.execute("""
        CREATE TABLE IF NOT EXISTS routes (
            origin      TEXT NOT NULL,
            dest        TEXT NOT NULL,
            route       TEXT NOT NULL,
            waypoints   TEXT,
            plan_id     INTEGER,
            downloads   INTEGER,
            likes       INTEGER,
            cycle       TEXT,
            created_at  TEXT,
            source      TEXT DEFAULT 'flightplandatabase',
            PRIMARY KEY (origin, dest, route)
        )
    """)
    # 给老库补列：早期版本没有这些列。
    # PRAGMA table_info 返回 [(cid, name, type, notnull, default, pk), ...]。
    existing = {row[1] for row in conn.execute("PRAGMA table_info(routes)")}
    for col, typ in [
        ("downloads", "INTEGER"),
        ("likes", "INTEGER"),
        ("cycle", "TEXT"),
        ("created_at", "TEXT"),
    ]:
        if col not in existing:
            # ALTER TABLE ADD COLUMN 只能加列，不能改类型。
            conn.execute(f"ALTER TABLE routes ADD COLUMN {col} {typ}")

    # ⚠️ 建表/改表也要 commit，否则结构可能只在内存里。
    conn.commit()
    return conn


def save_route(conn, origin, dest, route_str, waypoints,
               plan_id, downloads, likes, cycle, created_at):
    """
    插入一条航路，返回本次新增行数（0 或 1）。

    ── 两条铁律 ────────────────────────────────────────────
    ① 值必须用 ? 占位符，绝不字符串拼接
         错：f"VALUES ('{origin}')"
             origin 含单引号 → 语法错
             origin = x'); DROP TABLE routes; -- → 表没了（SQL 注入）
         对：VALUES (?,?) + 元组，驱动负责安全转义
    ② INSERT 后必须 commit()，否则进程退出数据全丢
    ────────────────────────────────────────────────────────
    """
    before = conn.total_changes
    conn.execute(
        "INSERT OR IGNORE INTO routes "
        "(origin, dest, route, waypoints, plan_id, downloads, likes, cycle, created_at) "
        "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
        (
            origin,
            dest,
            route_str,
            # SQLite 没有数组类型 → 航点列表存成 JSON 字符串。
            # ensure_ascii=False：中文不转 \uXXXX，存进去可读。
            json.dumps(waypoints, ensure_ascii=False),
            plan_id,
            downloads,
            likes,
            cycle,
            created_at,
        ),
    )
    conn.commit()
    return conn.total_changes - before   # INSERT OR IGNORE 忽略时差值为 0


# ═════════════════════════════════════════════════════════════
# 五、主流程
# ═════════════════════════════════════════════════════════════
def main():
    origin = sys.argv[1] if len(sys.argv) > 1 else ORIGIN
    dest   = sys.argv[2] if len(sys.argv) > 2 else DEST

    print(f"=== 搜索 {origin} -> {dest}（取 100 条，本地按下载量排序）===")
    plans = search_plans(origin, dest, limit=100)
    print(f"拿到 {len(plans)} 条计划")

    if not plans:
        print("没有计划可用，退出。")
        return

    plan, has_cycle = pick_best_plan(plans)
    plan_id = plan["id"]

    print()
    print("下载量前 5（★ = 带 cycle）：")
    for p in sorted(plans, key=lambda x: x.get("downloads") or 0, reverse=True)[:5]:
        cyc = (p.get("cycle") or {}).get("ident") or "-"
        mark = "★" if cyc != "-" else " "
        print(f"  {mark} id={p['id']:<9} dl={p.get('downloads', 0):<4} "
              f"likes={p.get('likes', 0):<3} wps={p.get('waypoints', 0):<4} "
              f"cycle={cyc}")

    cycle_ident = (plan.get("cycle") or {}).get("ident")
    created_at = plan.get("createdAt")

    print()
    print(f"选中 id={plan_id}（dl={plan.get('downloads', 0)}，"
          f"likes={plan.get('likes', 0)}，cycle={cycle_ident or '无'}）")
    if not has_cycle:
        print("  ⚠️ 这条计划没有 cycle 信息，导航数据版本未知")

    detail = get_plan_detail(plan_id)
    if not detail:
        print("取详情失败，退出。")
        return

    waypoints = extract_waypoints(detail)
    if not waypoints:
        print("这条计划没有航点，退出。")
        return

    route_str = " ".join(waypoints)   # 本版本不含 via 航路名

    conn = open_db()
    added = save_route(
        conn, origin, dest, route_str, waypoints,
        plan_id,
        plan.get("downloads", 0),
        plan.get("likes", 0),
        cycle_ident,
        created_at,
    )

    total = conn.execute("SELECT COUNT(*) FROM routes").fetchone()[0]

    print()
    print(f"航点（{len(waypoints)} 个）：")
    print(f"  {route_str}")
    print()
    print(f"本次新增 {added} 条，数据库共 {total} 条 → {DB_PATH}")

    # 读回来确认（SELECT 结果是行元组）
    row = conn.execute(
        "SELECT origin, dest, route, plan_id, downloads, cycle, source "
        "FROM routes WHERE origin=? AND dest=? "
        "ORDER BY downloads DESC LIMIT 1",
        (origin, dest),
    ).fetchone()
    if row:
        print()
        print("库里读回（该 O-D 下载量最高的一条）：")
        print(f"  origin    = {row[0]}")
        print(f"  dest      = {row[1]}")
        print(f"  route     = {row[2][:160]}")
        print(f"  plan_id   = {row[3]}")
        print(f"  downloads = {row[4]}")
        print(f"  cycle     = {row[5]}")
        print(f"  source    = {row[6]}")

    conn.close()


if __name__ == "__main__":
    main()
